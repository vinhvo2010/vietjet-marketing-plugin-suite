{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietjet.example/schemas/experiment-card.schema.json",
  "title": "Vietjet Marketing Experiment Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id", "hypothesis", "unit", "treatment", "control", "primary_metric", "guardrails", "decision_rule", "owner"],
  "properties": {
    "experiment_id": {"type": "string", "minLength": 3},
    "hypothesis": {"type": "string", "minLength": 10},
    "unit": {"type": "string"},
    "treatment": {"type": "string"},
    "control": {"type": "string"},
    "primary_metric": {"type": "string"},
    "guardrails": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "decision_rule": {"type": "string", "minLength": 5},
    "owner": {"type": "string", "minLength": 2},
    "start": {"type": "string"},
    "end": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
