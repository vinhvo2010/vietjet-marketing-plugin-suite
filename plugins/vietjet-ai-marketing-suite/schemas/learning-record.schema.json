{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vietjet.example/schemas/learning-record.schema.json",
  "title": "Vietjet Marketing Learning Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["mission_id", "measurement_status", "result_window", "primary_metric", "result", "limitations", "decision_change", "owner", "next_decision"],
  "properties": {
    "mission_id": {"type": "string", "minLength": 3},
    "measurement_status": {"enum": ["EXPERIMENTAL", "MODELED", "DIAGNOSTIC_ONLY", "NOT_MEASURED"]},
    "result_window": {"type": "string", "minLength": 1},
    "primary_metric": {"type": "string", "minLength": 1},
    "result": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "decision_change": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "next_decision": {"type": "string", "minLength": 1}
  }
}
